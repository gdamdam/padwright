{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Padwright",
  "version": "1.0.0",
  "identifier": "com.padwright.app",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Padwright — SP-404MKII Bank Builder",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/padwright-server",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "category": "Music",
    "shortDescription": "Padwright — SP-404MKII Bank Builder",
    "longDescription": "Padwright builds, audits, and curates 16-pad banks for the Roland SP-404MKII from your local sample library.",
    "macOS": {
      "exceptionDomain": "127.0.0.1"
    }
  },
  "plugins": {}
}
