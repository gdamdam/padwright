{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-navigate",
    "core:window:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {"name": "sp404-server", "sidecar": true},
        {"name": "ffmpeg", "sidecar": true},
        {"name": "ffprobe", "sidecar": true}
      ]
    }
  ]
}
