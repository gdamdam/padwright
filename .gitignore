# Padwright — repository hygiene.
# Everything that should never enter the public history goes here.

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Python virtualenvs (always per-user)
.venv/
venv/
env/

# ── Web / Tauri / Node build artifacts ──────────────────────────────────────
node_modules/
src-tauri/target/
src-tauri/gen/
dist/
build/
*.spec.bak

# ── Generated icons (regenerate via `cargo tauri icon` from a source PNG) ───
src-tauri/icons/*.png
src-tauri/icons/*.icns
src-tauri/icons/*.ico
src-tauri/icons/android/
src-tauri/icons/ios/
icon.png

# ── Bundled sidecars (built locally; license-sensitive, large) ──────────────
src-tauri/binaries/sp404-server-*
src-tauri/binaries/padwright-server-*
src-tauri/binaries/ffmpeg-*
src-tauri/binaries/ffprobe-*

# ── Per-user config + user data ─────────────────────────────────────────────
config.json
.crates/

# ── Internal docs (not for public consumption) ──────────────────────────────
md/

# ── macOS / editor cruft ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
*.swp
*~
.idea/
.vscode/
.cursor/
.claude/

# ── Local secrets / env ─────────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
secrets/
